# Copy to .env and adjust. Never commit .env.

# --- Docker Compose ---------------------------------------------------------
POSTGRES_USER=smoothstream
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smoothstream
# Host interface/port the app is published on. Keep 127.0.0.1 when a reverse
# proxy (nginx, Caddy, Cloudflare Tunnel) runs on the same machine.
APP_BIND=127.0.0.1
APP_PORT=8080

# --- Running without Docker (pnpm dev / pnpm start / pnpm db:push) ----------
DATABASE_URL=postgresql://smoothstream:change-me@localhost:5432/smoothstream

# --- API server (optional) --------------------------------------------------
# PORT=8080
# HOST=0.0.0.0
# LOG_LEVEL=info
# Path to the built frontend; defaults to artifacts/smoothstream/dist/public.
# STATIC_DIR=
# Only needed if the UI is hosted on a different origin than the API.
# CORS_ORIGIN=https://smoothstream.example.com
# Proxies trusted for X-Forwarded-*; "false" if exposed directly.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# --- Frontend dev server (optional) -----------------------------------------
# Vite port, base path, API target, and extra allowed hostnames.
# PORT=5173
# BASE_PATH=/
# API_URL=http://localhost:8080
# ALLOWED_HOSTS=smoothstream.lan
